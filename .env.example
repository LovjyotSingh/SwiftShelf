# ==============================================================================
# SwiftShelf - Environment Configuration Example
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database Connection (Supabase / Neon / Local Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/swiftshelf?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/swiftshelf?schema=public"

# Redis Cache & Distributed Lock (Upstash Redis / Local Redis)
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Stripe Payment Infrastructure
STRIPE_SECRET_KEY=sk_test_mock_secret_key_swiftshelf
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_mock_publishable_key_swiftshelf
STRIPE_WEBHOOK_SECRET=whsec_mock_webhook_secret

# AI Search & Multimodal Services (Google Gemini / OpenAI)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Edge Authentication & Security
NEXTAUTH_SECRET=super_secure_jwt_secret_swiftshelf_32_chars
NEXTAUTH_URL=http://localhost:3000
ADMIN_SECRET_KEY=admin_master_swiftshelf_pass_2026
