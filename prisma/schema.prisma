// SwiftShelf Database Schema - MongoDB Atlas Connector
// Optimized for MongoDB Document collections with B+ Tree Indexing

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  SUPPORT
}

enum OrderStatus {
  PENDING
  RESERVED
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders       Order[]
  reviews      Review[]
  reservations InventoryReservation[]

  @@index([role])
}

model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
}

model Product {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  slug            String    @unique
  subtitle        String?
  description     String
  price           Float
  originalPrice   Float?
  categoryId      String    @db.ObjectId
  category        Category  @relation(fields: [categoryId], references: [id])
  rating          Float     @default(0.0)
  reviewCount     Int       @default(0)
  images          String[]
  model3dUrl      String?
  badge           String?
  isFlashSale     Boolean   @default(false)
  flashSaleEndsAt DateTime?
  stock           Int       @default(0)
  reservedStock   Int       @default(0)
  tags            String[]
  features        String[]
  specs           Json?

  variants     ProductVariant[]
  reviews      Review[]
  orderItems   OrderItem[]
  reservations InventoryReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, price])
  @@index([isFlashSale, flashSaleEndsAt])
  @@index([rating, reviewCount])
}

model ProductVariant {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  productId     String   @db.ObjectId
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  sku           String   @unique
  colorName     String
  colorHex      String
  priceDelta    Float    @default(0.0)
  stock         Int      @default(0)
  reservedStock Int      @default(0)

  reservations InventoryReservation[]
  orderItems   OrderItem[]

  @@index([productId, sku])
}

model InventoryReservation {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  productId String          @db.ObjectId
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?         @db.ObjectId
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  userId    String?         @db.ObjectId
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  quantity  Int
  expiresAt DateTime
  isClaimed Boolean         @default(false)
  createdAt DateTime        @default(now())

  @@index([expiresAt, isClaimed])
  @@index([productId, variantId])
}

model Order {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber     String      @unique
  userId          String?     @db.ObjectId
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName    String
  customerEmail   String
  shippingAddress Json
  subtotal        Float
  discountAmount  Float       @default(0.0)
  taxAmount       Float
  shippingAmount  Float       @default(0.0)
  total           Float
  status          OrderStatus @default(PENDING)
  paymentIntentId String?     @unique
  idempotencyKey  String      @unique

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([customerEmail])
  @@index([status, createdAt])
  @@index([idempotencyKey])
}

model OrderItem {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  orderId    String          @db.ObjectId
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String          @db.ObjectId
  product    Product         @relation(fields: [productId], references: [id])
  variantId  String?         @db.ObjectId
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  quantity   Int
  unitPrice  Float
  totalPrice Float

  @@index([orderId])
  @@index([productId])
}

model Review {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  productId        String   @db.ObjectId
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String?  @db.ObjectId
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName         String
  rating           Int
  title            String
  comment          String
  verifiedPurchase Boolean  @default(true)
  helpfulCount     Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([productId, rating])
}

model ProcessedWebhook {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId   String   @unique
  eventType String
  payload   Json
  createdAt DateTime @default(now())

  @@index([eventId])
}
